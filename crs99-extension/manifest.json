{
  "manifest_version": 3,
  "name": "CRS 99 Copilot",
  "version": "1.0.0",
  "description": "Fluxo simples para 99Freelas: botões na lista, nova aba por projeto, autofill protegido e clique final sempre humano.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://www.99freelas.com.br/projects*",
        "https://99freelas.com.br/projects*"
      ],
      "js": ["core.js", "projects-flow.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.99freelas.com.br/project/*",
        "https://99freelas.com.br/project/*"
      ],
      "js": ["core.js", "project-flow.js"],
      "run_at": "document_idle"
    }
  ]
}