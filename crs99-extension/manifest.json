{
  "manifest_version": 3,
  "name": "CRS 99 Copilot",
  "version": "0.6.4",
  "description": "Copiloto CRS rápido com fila reconstruída por ID real, descarte de propostas já enviadas e autofill protegido por projeto.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.99freelas.com.br/*",
    "https://99freelas.com.br/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.99freelas.com.br/project/*",
        "https://99freelas.com.br/project/*"
      ],
      "js": ["autopilot-fast-v2.js", "queue-fast.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.99freelas.com.br/projects*",
        "https://99freelas.com.br/projects*"
      ],
      "js": ["scanner-fast.js", "queue-fast.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.99freelas.com.br/p/*",
        "https://99freelas.com.br/p/*"
      ],
      "js": ["queue-fast.js"],
      "run_at": "document_idle"
    }
  ]
}