{
  "manifest_version": 3,
  "name": "CRS 99 Copilot",
  "version": "0.6.1",
  "description": "Copiloto CRS para manter uma fila persistente de novas oportunidades, preparar propostas e retirar automaticamente as já enviadas.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.99freelas.com.br/*",
    "https://99freelas.com.br/*",
    "https://crs-digital-factory.vercel.app/*",
    "https://raw.githubusercontent.com/cristiansembarski2-ship-it/crs-digital-factory/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.99freelas.com.br/project/*",
        "https://99freelas.com.br/project/*"
      ],
      "css": ["content.css"],
      "js": ["content.js", "title-fix.js", "status-fix.js", "autopilot.js", "sent-tracker.js", "queue-panel.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.99freelas.com.br/projects*",
        "https://99freelas.com.br/projects*"
      ],
      "js": ["scanner.js", "queue-panel.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.99freelas.com.br/p/*",
        "https://99freelas.com.br/p/*"
      ],
      "js": ["queue-panel.js"],
      "run_at": "document_idle"
    }
  ]
}