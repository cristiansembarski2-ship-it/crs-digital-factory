{
  "manifest_version": 3,
  "name": "CRS 99 Copilot",
  "version": "0.4.0",
  "description": "Copiloto interno da CRS Digital para analisar projetos, priorizar exclusivos Premium e preparar propostas completas no 99Freelas sem enviar sozinho.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://crs-digital-factory.vercel.app/*",
    "https://raw.githubusercontent.com/cristiansembarski2-ship-it/crs-digital-factory/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.99freelas.com.br/project/*",
        "https://99freelas.com.br/project/*"
      ],
      "css": ["content.css"],
      "js": ["content.js", "title-fix.js", "status-fix.js", "autopilot.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.99freelas.com.br/projects*",
        "https://99freelas.com.br/projects*"
      ],
      "css": ["scanner.css"],
      "js": ["scanner.js"],
      "run_at": "document_idle"
    }
  ]
}